# Supabase Postgres (Project Settings → Database → Connection string)
# Transaction pooler (:6543) for the app / Vercel serverless
DATABASE_URL="postgresql://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session / Direct (:5432) for prisma db push / migrations
DIRECT_URL="postgresql://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# NextAuth — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-long-random-secret"
# Local only. On Vercel set this to your live URL, e.g. https://devertstore.vercel.app
# If AUTH_URL is localhost in production, login will redirect to localhost.
AUTH_URL="http://localhost:3000"

ADMIN_EMAIL="admin@devert.store"
ADMIN_PASSWORD="change-me"
ADMIN_NAME="Devert Admin"

# Optional — only if you use the Supabase JS client later
# NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# May help desk (optional). Without this key, May uses 1000 curated FAQ answers.
# OPENAI_API_KEY="sk-..."
# OPENAI_MODEL="gpt-4o-mini"
